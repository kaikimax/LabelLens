<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>dev.labellens</groupId>
        <artifactId>labellens-parent</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>labellens-app</artifactId>
    <name>LabelLens app</name>

    <!-- No versions below: the Spring Boot parent manages them all. -->
    <dependencies>
        <!-- REST API (Spring Boot 4 name for the old spring-boot-starter-web) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc</artifactId>
        </dependency>
        <!-- Web pages (day 10): server-rendered HTML; htmx is a static file, no JavaScript build -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-thymeleaf</artifactId>
        </dependency>
        <!-- Database access with JPA/Hibernate -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <!-- Database migrations. In Boot 4 this starter is required: flyway-core alone silently does nothing. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-flyway</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
        </dependency>
        <!-- /actuator/health, used by Azure to check the app is alive -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <!-- Calls the AI model. Since Spring AI 2.0, this one module also covers Azure OpenAI / Microsoft Foundry. -->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-starter-model-openai</artifactId>
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- Tests -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Starts a real PostgreSQL in Docker during tests -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-testcontainers</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-postgresql</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- The generic eval harness (day 5). Only the eval tests use it. -->
        <dependency>
            <groupId>dev.labellens</groupId>
            <artifactId>labellens-eval-core</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- Builds the runnable jar and lets you run the app with mvn spring-boot:run -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
            <!-- Tests tagged "eval" call the real model (it costs money): never in the normal build. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <excludedGroups>eval</excludedGroups>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!--
          mvn -pl app test -Peval                         runs ONLY the eval, 3 runs per product
          mvn -pl app test -Peval "-Deval.runs=1"         1 run per product (cheaper, less reliable)
          mvn -pl app test -Peval "-Deval.only=p004,p007" only these products
          mvn -pl app test -Peval "-Deval.saveBaseline=true"  also saves the scores as the new baseline
        -->
        <profile>
            <id>eval</id>
            <properties>
                <eval.runs>3</eval.runs>
                <eval.only></eval.only>
                <eval.saveBaseline>false</eval.saveBaseline>
                <eval.maxDrop>3</eval.maxDrop>
            </properties>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-surefire-plugin</artifactId>
                        <configuration>
                            <groups>eval</groups>
                            <!-- "none" is a tag nobody uses: it cancels the default exclusion of "eval". -->
                            <excludedGroups>none</excludedGroups>
                            <systemPropertyVariables>
                                <eval.runs>${eval.runs}</eval.runs>
                                <eval.only>${eval.only}</eval.only>
                                <eval.saveBaseline>${eval.saveBaseline}</eval.saveBaseline>
                                <eval.maxDrop>${eval.maxDrop}</eval.maxDrop>
                            </systemPropertyVariables>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
