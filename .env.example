# Copy this file to ".env" (same folder) and fill in your values.
# .env is in .gitignore: it must NEVER be committed.

# Foundry → your resource → Keys and Endpoint. Example: https://labellens.openai.azure.com
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=

# The deployment name you chose in Foundry.
LABELLENS_READER_DEPLOYMENT=gpt-4.1-mini

# The allergen model, used together with the Java word list (decisions log, 2026-10-31).
LABELLENS_ALLERGEN_DEPLOYMENT=gpt-4.1
